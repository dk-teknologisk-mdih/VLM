def inspection_program():
  # ---------------------------------------------------------------
  # T_base_cam as a URScript pose p[x, y, z, rx, ry, rz]
  #   Translation from column-3 of the 4x4 matrix.
  #   Orientation: axis-angle derived from the 3x3 rotation block.
  # ---------------------------------------------------------------
  T_base_cam = p[0.26133171757465096, -0.21193715811891062, 0.32093135558712477, -1.534970, 0.016031, 0.032626]
  accel = 0.5
  vel   = 0.1

  # -- Waypoint  1 : endpoint: top of head tube  (movej for safe initial approach) --
  target = pose_trans(T_base_cam, p[0.2885435898603318, -0.3586976932089486, 0.99, 0, 0, 0])
  movej(target, a=1.0, v=0.5, t=0, r=0)
  sleep(1.0)

  # -- Waypoint  2 : joint: head tube / top tube --
  target = pose_trans(T_base_cam, p[0.2912755933876787, -0.2926188230296982, 0.99, 0, 0, 0])
  movel(target, a=accel, v=vel, t=0, r=0)
  sleep(1.0)

  # -- Waypoint  3 : joint: head tube / down tube --
  target = pose_trans(T_base_cam, p[0.3322556462978813, -0.2265399528504478, 0.99, 0, 0, 0])
  movel(target, a=accel, v=vel, t=0, r=0)
  sleep(1.0)

