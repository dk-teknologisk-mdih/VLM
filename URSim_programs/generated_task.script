def inspection_program():
  # -----------------------------------------------------------
  # T_base_cam  -  camera-colour-frame → UR-base-frame
  # Pose p[x, y, z, rx, ry, rz] with axis-angle orientation
  # derived from the supplied 4×4 homogeneous matrix.
  # -----------------------------------------------------------
  global T_base_cam = p[0.26133172, -0.21193716, 0.32093136, -1.535419, 0.016029, 0.032625]

  # Number of inspection waypoints
  global n_pts = 14

  # Waypoint coordinates in the camera colour frame (metres)
  global cam_x = [0.3022036074970661, 0.3609416833350231, 0.06998330767258477, -0.08437489162251179, -0.2920071597008716, -0.517397450706986, -0.4012873007947452, -0.25375911031801585, -0.1485769745151625, -0.12535494453271437, -0.08437489162251179, -0.12535494453271437, 0.0563232900358505, 0.3022036074970661]
  global cam_y = [-0.34102543723077694, -0.1643028774490608, -0.0144728811123884, 0.13535711522428412, 0.1584078838914644, 0.08925557788992333, -0.04136544455743216, -0.17967005656051438, -0.08362518711392948, -0.04136544455743216, 0.13535711522428412, -0.04136544455743216, -0.16046108267119744, -0.34102543723077694]
  global cam_z = [0.99, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99, 0.99]

  # Motion parameters (conservative for inspection)
  global move_vel = 0.1
  global move_acc = 0.5
  global dwell_time = 1.0

  # --- Approach first waypoint in joint-space (safe initial move) ---
  global pt_cam = p[cam_x[0], cam_y[0], cam_z[0], 0, 0, 0]
  global target_pose = pose_trans(T_base_cam, pt_cam)
  movej(target_pose, a=1.0, v=0.5)
  sleep(dwell_time)

  # --- Traverse remaining waypoints with linear moves ---
  global i = 1
  while i < n_pts:
    pt_cam = p[cam_x[i], cam_y[i], cam_z[i], 0, 0, 0]
    target_pose = pose_trans(T_base_cam, pt_cam)
    movel(target_pose, a=move_acc, v=move_vel)
    sleep(dwell_time)
    i = i + 1
  end
end
inspection_program()